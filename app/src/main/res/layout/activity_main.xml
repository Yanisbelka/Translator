<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Camera Preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/scanLine"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/bg_scan_line"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Navigation Bar -->
    <RelativeLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_gradient_top"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/bg_glass_circle"
            android:padding="12dp"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Vision Capture"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05" />
    </RelativeLayout>

    <ImageButton
        android:id="@+id/btnFlashlight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:src="@android:drawable/btn_star_big_off"
        android:background="@drawable/bg_bubble"
        android:backgroundTint="#4D000000"
        android:padding="12dp"
        android:contentDescription="Flashlight"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFF" />

    <!-- Bottom Controls Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="@drawable/bg_gradient_bottom"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Translation Result Card (Professional Modern Style) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardResult"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardCornerRadius="32dp"
        app:cardElevation="12dp"
        app:strokeWidth="2dp"
        app:strokeColor="@color/vibrant_purple"
        app:cardBackgroundColor="@color/glass_bg"
        app:layout_constraintBottom_toTopOf="@+id/camera_menu_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Drag Handle for Resizing (with larger touch area) -->
            <FrameLayout
                android:id="@+id/resizeHandle"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="#4DFFFFFF"
                    android:backgroundTint="#80FFFFFF" />
            </FrameLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Live Translation"
                    android:textColor="#80FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium"
                    android:textAllCaps="true"
                    android:letterSpacing="0.2" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnTTS"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="#80FFFFFF" />

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <ImageButton
                        android:id="@+id/btnCopy"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#80FFFFFF" />
                </LinearLayout>
            </RelativeLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/textResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:text="Point camera at text..."
                    android:lineSpacingExtra="3dp"
                    android:textAlignment="viewStart"
                    android:textDirection="firstStrong"
                    android:textIsSelectable="true" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Professional Menu Bar -->
    <LinearLayout
        android:id="@+id/camera_menu_container"
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@drawable/bg_menu_itemblack"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/btnLanguage"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_language_selector"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/txtSourceLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="@color/vibrant_purple"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginHorizontal="6dp"
                android:src="@android:drawable/ic_menu_revert"
                android:rotation="180"
                app:tint="@color/vibrant_purple" />

            <TextView
                android:id="@+id/txtCurrentLang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FR"
                android:textColor="@color/vibrant_purple"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnGallery"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Gallery Import"
            android:padding="12dp"
            app:tint="@color/vibrant_purple" />

        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnTranslate"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@android:drawable/ic_menu_camera"
            android:background="@drawable/bg_circle_primary"
            android:scaleType="centerInside"
            android:padding="18dp"
            android:elevation="16dp"
            android:contentDescription="Capture Translation"
            app:tint="#FFFFFF" />

        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="History"
            android:padding="12dp"
            app:tint="@color/vibrant_purple" />
    </LinearLayout>

    <Spinner
        android:id="@+id/languageSpinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Spinner
        android:id="@+id/sourceSpinner"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>